# Edge Function secrets (set with: supabase secrets set --env-file .env). Never commit the real file.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase inside Edge Functions.
# For `supabase functions serve` locally, put them in supabase/functions/.env instead.

# --- required ---
SITE_URL=http://localhost:3000                 # the website origin; the only origin CORS allows (plus ALLOWED_ORIGINS)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # Cloudflare test secret: always passes. Use a real one in production.
REPORT_TOKEN_SECRET=change-me-long-random-string            # signs the report links in emails
IP_HASH_SALT=change-me-another-random-string                # salts the IP hash used for rate limits
CRON_SECRET=change-me-third-random-string                   # shared with pg_cron for the maintenance function

# --- search provider (without a key, search-backed checks are skipped and left out of the score) ---
SEARCH_PROVIDER=brave                          # brave | serper | you
SEARCH_API_KEY=

# --- email (without these, unlocking still works but no email is sent) ---
EMAIL_PROVIDER=resend                          # resend | brevo
EMAIL_API_KEY=
EMAIL_FROM=Amplibee <reports@your-domain.example>

# --- optional ---
PSI_API_KEY=                                   # Google PageSpeed Insights key; without it the shared quota is often exhausted
GITHUB_TOKEN=                                  # raises the GitHub search rate limit
ALLOWED_ORIGINS=                               # extra CORS origins, comma separated (for example a Vercel preview URL)
FREE_CHECKS_PER_IP_PER_DAY=10
GLOBAL_DAILY_CAP=500
UNLOCKS_PER_IP_PER_DAY=10
CONTACT_PER_IP_PER_DAY=5
CONTACT_NOTIFY_EMAIL=hello@amplibee.com        # where contact form messages are emailed
TRANCO_TOP_N=100000

# --- LLM features, off by default. The app works fully without them. ---
ENABLE_LLM=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
FEATURE_COMPETITOR_SUGGEST=false               # needs ENABLE_LLM=true
