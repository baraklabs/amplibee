{
  "name": "amplibee",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.supabase.json && npm run typecheck -w apps/web",
    "lint:copy": "node scripts/copy-lint.mjs",
