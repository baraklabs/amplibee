# Public values only. Everything here ends up in the browser bundle. Never put a secret in this file.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Ends in /v1. Local: supabase functions serve. Hosted: https://<project-ref>.supabase.co/functions/v1/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:54321/functions/v1/api/v1
# Cloudflare test site key: always passes. Use a real one in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_CONTACT_EMAIL=
# Set to false to send Oyekool only the sign-up link and UTM tags, without prefill parameters.
NEXT_PUBLIC_OYEKOOL_PREFILL=true

# Server-side only (not exposed to the browser). Set to true to let search engines index report pages.
REPORT_INDEXABLE=false

# Sign in with Google. The OAuth client id is public by design (the Edge Function checks it again as GOOGLE_CLIENT_ID).
# Create it in Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web) and add the site URL under
# Authorized JavaScript origins. Leave empty to hide the Google button; email and password still work.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
